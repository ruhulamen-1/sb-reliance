# Server
PORT=3000
NODE_ENV=development

# MySQL (on hosting, copy these from the control panel's MySQL section)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sbreliance

# Admin login. In production both MUST be changed or the server will not start.
JWT_SECRET=change-this-secret
ADMIN_EMAIL=admin@sbreliance.local
ADMIN_PASSWORD=Admin@12345

# Optional: keep uploaded images outside the app folder (absolute path)
# UPLOAD_DIR=/home/USER/sb-reliance-uploads
